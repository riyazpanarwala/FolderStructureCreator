<UserControl x:Class="FolderStructureCreator.Views.OrgChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="MainGrid">
        <ScrollViewer x:Name="ChartScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent">
            <Canvas x:Name="RootCanvas" Background="Transparent" Margin="4" RenderTransformOrigin="0,0">
                <Canvas.LayoutTransform>
                    <ScaleTransform x:Name="ChartScale" ScaleX="1" ScaleY="1"/>
                </Canvas.LayoutTransform>
            </Canvas>
        </ScrollViewer>

        <!-- Root Drop Target Overlay Banner (Shown only during Drag) -->
        <Border x:Name="RootDropBanner" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16"
                Background="#0F766E" BorderBrush="#0D9488" BorderThickness="1.5" CornerRadius="8"
                Padding="16,8" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎯 Drop here to move folder to Root level" FontSize="12.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
