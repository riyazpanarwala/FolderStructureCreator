<UserControl x:Class="FolderStructureCreator.Views.OrgChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="MainGrid">
        <ScrollViewer x:Name="ChartScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent">
            <Canvas x:Name="RootCanvas" Background="Transparent" Margin="4" RenderTransformOrigin="0,0">
                <Canvas.LayoutTransform>
                    <ScaleTransform x:Name="ChartScale" ScaleX="1" ScaleY="1"/>
                </Canvas.LayoutTransform>
            </Canvas>
        </ScrollViewer>

        <!-- Root Drop Target Overlay Banner (Shown only during Drag) -->
        <Border x:Name="RootDropBanner" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16"
                Background="#0F766E" BorderBrush="#0D9488" BorderThickness="1.5" CornerRadius="8"
                Padding="16,8" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎯 Drop here to move folder to Root level" FontSize="12.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Mini-Map Overlay Box (Bottom-Right Corner) -->
        <Border x:Name="MiniMapBorder" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16"
                Background="#0F172A" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="8"
                Padding="6" Visibility="Visible" Opacity="0.85" Panel.ZIndex="900"
                MouseEnter="MiniMapBorder_MouseEnter" MouseLeave="MiniMapBorder_MouseLeave">
            <Border.RenderTransform>
                <TranslateTransform x:Name="MiniMapTransform"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <DockPanel x:Name="MiniMapHeader" Margin="2,0,2,4" Background="Transparent" Cursor="SizeAll"
                           ToolTip="Drag header to move mini-map"
                           PreviewMouseLeftButtonDown="MiniMapHeader_PreviewMouseLeftButtonDown"
                           PreviewMouseMove="MiniMapHeader_PreviewMouseMove"
                           PreviewMouseLeftButtonUp="MiniMapHeader_PreviewMouseLeftButtonUp">
                    <TextBlock Text="🗺️ Mini-Map" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <Button x:Name="MinimizeMiniMapButton" Content="✕" Style="{StaticResource ToolButton}" DockPanel.Dock="Right" Padding="4,1" FontSize="10" Click="MinimizeMiniMap_Click" ToolTip="Minimize Mini-Map to corner badge"/>
                    <Button x:Name="ToggleMiniMapSizeButton" Content="↗" Style="{StaticResource ToolButton}" DockPanel.Dock="Right" Padding="4,1" FontSize="10" Margin="0,0,3,0" Click="ToggleMiniMapSize_Click" ToolTip="Expand Mini-Map size"/>
                    <Button Content="🎯" Style="{StaticResource ToolButton}" DockPanel.Dock="Right" Padding="4,1" FontSize="10" Margin="0,0,3,0" Click="MiniMapFit_Click" ToolTip="Fit entire chart to view"/>
                </DockPanel>
                <Border x:Name="MiniMapVisualContainer" Width="160" Height="110" CornerRadius="4" ClipToBounds="True" Background="#1E293B" BorderBrush="#475569" BorderThickness="1">
                    <Canvas x:Name="MiniMapCanvas" Width="160" Height="110" Cursor="Hand"
                            Background="Transparent"
                            PreviewMouseLeftButtonDown="MiniMapCanvas_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="MiniMapCanvas_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="MiniMapCanvas_PreviewMouseLeftButtonUp"
                            PreviewMouseWheel="MiniMapCanvas_PreviewMouseWheel">
                        <!-- Canvas bounds outline representing actual diagram extent within letterboxed viewport -->
                        <Rectangle x:Name="MiniMapCanvasBoundsRect" Fill="#1E293B" Stroke="#475569" StrokeThickness="1" StrokeDashArray="2 2" RadiusX="2" RadiusY="2" Visibility="Collapsed"/>
                        <!-- Live Visual clone of main diagram canvas -->
                        <Rectangle x:Name="MiniMapVisualRect" Width="160" Height="110"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderOptions.EdgeMode="Aliased">
                            <Rectangle.Fill>
                                <VisualBrush x:Name="MiniMapVisualBrush" Visual="{Binding ElementName=RootCanvas}" Stretch="Uniform"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Canvas overlay for node selection & search highlights -->
                        <Canvas x:Name="MiniMapOverlayCanvas" Width="160" Height="110" IsHitTestVisible="True"/>
                        <!-- Viewfinder indicator representing current viewport -->
                        <Rectangle x:Name="MiniMapViewportRect" Stroke="#38BDF8" StrokeThickness="1.5" Fill="#3038BDF8" RadiusX="2" RadiusY="2" Cursor="SizeAll"/>
                    </Canvas>
                </Border>
            </StackPanel>
        </Border>

        <!-- Floating Corner Badge (Shown when Mini-Map is Minimized) -->
        <Button x:Name="MiniMapBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16"
                Background="#0F172A" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1.5"
                Padding="8,5" FontSize="11" FontWeight="SemiBold" Click="RestoreMiniMap_Click"
                ToolTip="Restore Mini-Map overlay" Visibility="Collapsed" Panel.ZIndex="900">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="badgeBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗺️ Mini-Map" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="badgeBorder" Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="#38BDF8"/>
                            <Setter TargetName="badgeBorder" Property="BorderBrush" Value="#38BDF8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
