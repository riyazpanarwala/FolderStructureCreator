<Window x:Class="FolderStructureCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FolderStructureCreator.ViewModels"
        xmlns:conv="clr-namespace:FolderStructureCreator.Converters"
        xmlns:views="clr-namespace:FolderStructureCreator.Views"
        xmlns:models="clr-namespace:FolderStructureCreator.Models"
        xmlns:services="clr-namespace:FolderStructureCreator.Services"
        Title="Folder Structure Creator" Height="720" Width="1180" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" Icon="AppIcon.ico"
        Background="{DynamicResource BrushBg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding OpenCommandPaletteCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:BoolToGridLengthConverter x:Key="BoolToGridLength"/>
        <conv:PlaceholderBrushConverter x:Key="PlaceholderBrush"/>
        <conv:BoolToLayoutDirectionConverter x:Key="BoolToLayoutDirection"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Window.DataContext><vm:MainViewModel/></Window.DataContext>
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="16"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFullscreenMode}" Value="True">
                        <Setter Property="Margin" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Title, Live Sync Status, Compact Command Palette, Settings Menu, Streamlined Stepper -->
        <Grid Grid.Row="0" Margin="2,0,2,14" Visibility="{Binding IsFullscreenMode, Converter={StaticResource InverseBoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Folder Structure Creator" Style="{StaticResource AppTitle}"/>
                <TextBlock Text="Design a reusable folder plan, then create it in a target destination." Style="{StaticResource SubText}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Live Sync Active Amber Warning Badge -->
                <Border Background="{DynamicResource BrushWarningSoft}" BorderBrush="{DynamicResource BrushWarning}" BorderThickness="1" CornerRadius="12" Padding="8,4" Margin="0,0,10,0" Visibility="{Binding IsLiveSyncMode, Converter={StaticResource BoolToVis}}" ToolTip="Live sync active: additions, renames, and deletions immediately modify folders on disk.">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushWarning}" Margin="0,0,6,0"/>
                        <TextBlock Text="Live Sync ON" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushWarning}"/>
                    </StackPanel>
                </Border>

                <!-- Compact Command Palette Button -->
                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenCommandPaletteCommand}" ToolTip="Open command palette (Ctrl+K)" Padding="8,5" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource SearchGeometry}" Style="{StaticResource NavIcon}" Width="12" Height="12" Margin="0,0,6,0"/>
                        <TextBlock Text="Commands" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border Background="{DynamicResource BrushBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="4,1">
                            <TextBlock Text="Ctrl+K" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Accessible Settings Menu Button -->
                <Button x:Name="SettingsButton" Style="{StaticResource ToolButton}" Click="SettingsButton_Click" ToolTip="Application settings, themes, and options" Margin="0,0,12,0" Padding="8,5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource SettingsGeometry}" Style="{StaticResource NavIcon}" Width="13" Height="13" Margin="0,0,5,0"/>
                        <TextBlock Text="Settings" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Appearance">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource ChartGeometry}" Style="{StaticResource NavIcon}"/>
                                </MenuItem.Icon>
                                <MenuItem Header="Dark Mode" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.Dark}"/>
                                <MenuItem Header="Light Mode" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.Light}"/>
                                <MenuItem Header="High Contrast" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.HighContrast}"/>
                                <MenuItem Header="Windows System Match" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.System}"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Smart Ignore Rules (.structureignore)" IsCheckable="True" IsChecked="{Binding EnableIgnoreRules, Mode=TwoWay}" StaysOpenOnClick="True" ToolTip="When checked, imports ignore system/build folders (node_modules, bin, obj, .git) based on .structureignore and .gitignore patterns.">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource SyncGeometry}" Style="{StaticResource NavIcon}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Live Disk Sync" IsCheckable="True" IsChecked="{Binding IsLiveSyncMode, Mode=TwoWay}" StaysOpenOnClick="True" ToolTip="When checked, folder additions, renames, deletions (Recycle Bin), and moves directly update physical folders on disk.">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource RefreshGeometry}" Style="{StaticResource NavIcon}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Fullscreen Meeting Mode" InputGestureText="F11" Command="{Binding ToggleFullscreenCommand}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource ExpandGeometry}" Style="{StaticResource NavIcon}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Spotlight Command Palette" InputGestureText="Ctrl+K" Command="{Binding OpenCommandPaletteCommand}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource CommandPaletteGeometry}" Style="{StaticResource NavIcon}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Dynamic Workflow Readiness Indicator -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Plan Readiness Pill -->
                    <Border CornerRadius="10" Padding="8,3" BorderThickness="1" ToolTip="{Binding DetailedStatusTooltip}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                <Setter Property="Opacity" Value="0.75"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlanReady}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding PlanReadinessText}" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlanReady}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Ellipse Width="3" Height="3" Fill="{DynamicResource BrushTextSecondary}" Opacity="0.4" Margin="5,0"/>
                    <!-- Destination Readiness Pill -->
                    <Border CornerRadius="10" Padding="8,3" BorderThickness="1" ToolTip="{Binding DetailedStatusTooltip}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                <Setter Property="Opacity" Value="0.75"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDestinationReady}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding DestinationReadinessText}" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDestinationReady}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Ellipse Width="3" Height="3" Fill="{DynamicResource BrushTextSecondary}" Opacity="0.4" Margin="5,0"/>
                    <!-- Create Readiness Pill (Actionable vs Completed vs Pending) -->
                    <Border CornerRadius="10" Padding="8,3" BorderThickness="1" ToolTip="{Binding CreateButtonTooltip}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                <Setter Property="Opacity" Value="0.6"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCreateActionable}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushHover}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCreateCompleted}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CreateReadinessText}" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCreateActionable}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCreateCompleted}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Main Body: Sidebar and Blueprint Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ShouldHideDestinationSidebar, Converter={StaticResource BoolToGridLength}, ConverterParameter=300}" MinWidth="0" MaxWidth="480"/>
                <ColumnDefinition Width="{Binding ShouldHideDestinationSidebar, Converter={StaticResource BoolToGridLength}, ConverterParameter=Auto}"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Destination Browser -->
            <Border Grid.Column="0" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Visibility="{Binding ShouldHideDestinationSidebar, Converter={StaticResource InverseBoolToVis}}">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource DriveGeometry}" Style="{StaticResource NavIcon}" Stroke="{DynamicResource BrushAccent}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Destination" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleSortOrderCommand}" ToolTip="Toggle folder sort order (Ascending / Descending)" Padding="6,3" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource SortGeometry}" Style="{StaticResource NavIcon}" Width="11" Height="11" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding SortToggleText}" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Command="{Binding RefreshDrivesCommand}" ToolTip="Refresh available drives" AutomationProperties.Name="Refresh drives" Width="26" Height="26" Padding="4">
                                    <Path Data="{StaticResource RefreshGeometry}" Style="{StaticResource NavIcon}" Width="11" Height="11"/>
                                </Button>
                            </WrapPanel>
                        </DockPanel>
                        <TextBlock Text="Select target directory on disk" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Pinned Folders Section -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,10" Background="{DynamicResource BrushBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6" Visibility="{Binding HasPinnedFolders, Converter={StaticResource BoolToVis}}" PreviewMouseWheel="PinnedFolders_PreviewMouseWheel">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource PinGeometry}" Style="{StaticResource NavIcon}" Stroke="{DynamicResource BrushAccent}" Width="11" Height="11" Margin="0,0,5,0"/>
                                    <TextBlock Text="Pinned Folders" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Quick Access" Style="{StaticResource SubText}" FontSize="10.5"/>
                            </Grid>
                            <TreeView x:Name="PinnedFoldersTreeView"
                                      ItemsSource="{Binding PinnedFolders}"
                                      SelectedItemChanged="PinnedFoldersTreeView_SelectedItemChanged"
                                      MaxHeight="160"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.CanContentScroll="False">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                        <Setter Property="Tag" Value="{Binding DataContext, ElementName=PinnedFoldersTreeView}"/>
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Open in Explorer" Command="{Binding OpenSelectedFolderInExplorerCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <Path Data="{StaticResource ExplorerGeometry}" Style="{StaticResource NavIcon}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="View Chart" Command="{Binding ShowPinnedFolderChartCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <Path Data="{StaticResource ChartGeometry}" Style="{StaticResource NavIcon}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Select Destination" Command="{Binding SelectPinnedFolderCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <Path Data="{StaticResource CheckGeometry}" Style="{StaticResource NavIcon}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="Pin Subfolder" Command="{Binding PinFolderCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <Path Data="{StaticResource PinGeometry}" Style="{StaticResource NavIcon}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Unpin Folder" Command="{Binding UnpinFolderCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <Path Data="{StaticResource CloseGeometry}" Style="{StaticResource NavIcon}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type models:PinnedFolder}" ItemsSource="{Binding Node.Children}">
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource FolderGeometry}" Style="{StaticResource FolderIcon}" Width="13" Height="13" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="145" VerticalAlignment="Center" ToolTip="{Binding Path}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0">
                                                <Button Style="{StaticResource ToolButton}" Padding="6,2" Command="{Binding DataContext.ShowPinnedFolderChartCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" CommandParameter="{Binding}" ToolTip="View folder structure as an interactive org chart" AutomationProperties.Name="View chart">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource ChartGeometry}" Style="{StaticResource NavIcon}" Stroke="{DynamicResource BrushAccent}" Width="10" Height="10" Margin="0,0,3,0"/>
                                                        <TextBlock Text="Chart" FontSize="11" Foreground="{DynamicResource BrushAccent}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" Width="22" Height="22" Padding="3" Margin="2,0,0,0" ToolTip="More folder actions" AutomationProperties.Name="More actions" Click="PlanOverflowButton_Click" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                                    <Path Data="{StaticResource MoreGeometry}" Style="{StaticResource NavIconFilled}" Width="11" Height="11"/>
                                                    <Button.ContextMenu>
                                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="Select as Destination" Command="{Binding SelectPinnedFolderCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                <MenuItem.Icon>
                                                                    <Path Data="{StaticResource CheckGeometry}" Style="{StaticResource NavIcon}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Open in Explorer" Command="{Binding OpenSelectedFolderInExplorerCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                <MenuItem.Icon>
                                                                    <Path Data="{StaticResource ExplorerGeometry}" Style="{StaticResource NavIcon}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="View Chart" Command="{Binding ShowPinnedFolderChartCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                <MenuItem.Icon>
                                                                    <Path Data="{StaticResource ChartGeometry}" Style="{StaticResource NavIcon}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="Unpin Folder" Command="{Binding UnpinFolderCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                <MenuItem.Icon>
                                                                    <Path Data="{StaticResource CloseGeometry}" Style="{StaticResource NavIcon}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type models:FileSystemNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1">
                                            <Path Data="{StaticResource FolderGeometry}" Style="{StaticResource FolderIcon}" Width="13" Height="13" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushPlaceholder}"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </StackPanel>
                    </Border>

                    <!-- Drive TreeView -->
                    <TreeView x:Name="DirectoryTreeView" ItemsSource="{Binding Drives}" SelectedItemChanged="DirectoryTreeView_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Tag" Value="{Binding DataContext, ElementName=DirectoryTreeView}"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Open in Explorer" Command="{Binding OpenSelectedFolderInExplorerCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <Path Data="{StaticResource ExplorerGeometry}" Style="{StaticResource NavIcon}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="View Chart" Command="{Binding ShowSelectedFolderOrgChartCommand}">
                                                <MenuItem.Icon>
                                                    <Path Data="{StaticResource ChartGeometry}" Style="{StaticResource NavIcon}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Pin Folder" Command="{Binding PinSelectedFolderCommand}">
                                                <MenuItem.Icon>
                                                    <Path Data="{StaticResource PinGeometry}" Style="{StaticResource NavIcon}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1">
                                    <Path Data="{StaticResource FolderGeometry}" Style="{StaticResource FolderIcon}"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushPlaceholder}"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Splitter between panes -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Visibility="{Binding ShouldHideDestinationSidebar, Converter={StaticResource InverseBoolToVis}}"/>

            <!-- Right Pane: Folder Plan Blueprint Editor -->
            <Border Grid.Column="2" Background="{DynamicResource BrushPanel}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFullscreenMode}" Value="True">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="CornerRadius" Value="0"/>
                                <Setter Property="Background" Value="{DynamicResource BrushBg}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Margin" Value="12"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFullscreenMode}" Value="True">
                                    <Setter Property="Margin" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <!-- Top Toolbar for Folder Plan -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="{Binding IsFullscreenMode, Converter={StaticResource InverseBoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Folder plan" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource SubText}">
                                    <Run Text="{Binding TotalFolderCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text=" folders in plan"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Unified Segmented Control: Tree / Chart -->
                                <Border Background="{DynamicResource BrushBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Tree" Command="{Binding ShowTreeViewCommand}" ToolTip="Tree hierarchy view (indented list)" FocusVisualStyle="{StaticResource AppFocusVisual}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Padding" Value="14,5"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <!-- Unselected and hovered -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BrushHover}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                                        </Trigger>
                                                        <!-- Selected -->
                                                        <DataTrigger Binding="{Binding IsOrgChartView}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryBtnFg}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <!-- Selected and hovered -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsOrgChartView}" Value="False"/>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Background" Value="{DynamicResource BrushAccentHover}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryBtnFg}"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Chart" Command="{Binding ShowOrgChartViewCommand}" ToolTip="Visual diagram view (interactive chart)" FocusVisualStyle="{StaticResource AppFocusVisual}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Padding" Value="14,5"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <!-- Unselected and hovered -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BrushHover}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                                        </Trigger>
                                                        <!-- Selected -->
                                                        <DataTrigger Binding="{Binding IsOrgChartView}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryBtnFg}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <!-- Selected and hovered -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsOrgChartView}" Value="True"/>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Background" Value="{DynamicResource BrushAccentHover}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryBtnFg}"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Action Buttons Bar -->
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource ToolButton}" Command="{Binding AddRootFolderCommand}" Background="{DynamicResource BrushAccentSoft}" BorderBrush="{DynamicResource BrushAccent}" Foreground="{DynamicResource BrushAccent}" FontWeight="SemiBold" ToolTip="Add a top-level root folder to the plan">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource PlusGeometry}" Style="{StaticResource NavIcon}" Stroke="{DynamicResource BrushAccent}" Width="11" Height="11" Margin="0,0,5,0"/>
                                    <TextBlock Text="Add root folder" FontSize="12.5"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleQuickAddCommand}" ToolTip="Toggle quick-add row to quickly create multiple subfolders (comma-separated)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource PlusGeometry}" Style="{StaticResource NavIcon}" Width="10" Height="10" Margin="0,0,5,0"/>
                                    <TextBlock Text="Quick add" FontSize="12.5"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding ImportFromReferenceCommand}" ToolTip="Import an existing directory into the plan">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource ImportGeometry}" Style="{StaticResource NavIcon}" Width="12" Height="12" Margin="0,0,5,0"/>
                                    <TextBlock Text="Import folder" FontSize="12.5"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Click="ExportScript_Click" ToolTip="Export folder plan as a standalone executable script (.ps1, .bat, .sh)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource ExportGeometry}" Style="{StaticResource NavIcon}" Width="12" Height="12" Margin="0,0,5,0"/>
                                    <TextBlock Text="Export script" FontSize="12.5"/>
                                </StackPanel>
                            </Button>
                            <!-- Secondary Actions Overflow Menu -->
                            <Button x:Name="PlanOverflowButton" Style="{StaticResource IconButton}" Click="PlanOverflowButton_Click" ToolTip="More plan actions" AutomationProperties.Name="More actions" Width="28" Height="28">
                                <Path Data="{StaticResource MoreGeometry}" Style="{StaticResource NavIconFilled}" Width="14" Height="14"/>
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Compare Plan with Disk (Diff)" Command="{Binding CompareBlueprintWithDiskCommand}">
                                            <MenuItem.Icon>
                                                <Path Data="{StaticResource DiffGeometry}" Style="{StaticResource NavIcon}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Clear Folder Plan" Command="{Binding ClearPlanCommand}" Foreground="{DynamicResource BrushDanger}">
                                            <MenuItem.Icon>
                                                <Path Data="{StaticResource TrashGeometry}" Style="{StaticResource NavIcon}" Stroke="{DynamicResource BrushDanger}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </WrapPanel>

                        <!-- Collapsible Quick-add Row -->
                        <Grid Margin="0,8,0,0" Visibility="{Binding IsQuickAddVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding QuickAddNames, UpdateSourceTrigger=PropertyChanged}" Tag="Quick add subfolders: src, docs, tests..." ToolTip="Comma-separated folder names; added under the selected folder">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding QuickAddCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="Add" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding QuickAddCommand}" Visibility="{Binding HasQuickAddText, Converter={StaticResource BoolToVis}}" Padding="12,5"/>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="4,0,0,0" Command="{Binding ToggleQuickAddCommand}" ToolTip="Close quick add" Width="26" Height="26" Padding="4">
                                <Path Data="{StaticResource CloseGeometry}" Style="{StaticResource NavIcon}" Width="9" Height="9"/>
                            </Button>
                        </Grid>

                        <!-- Search Bar -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="SearchTextBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Tag="Search folders in plan... (Ctrl+F)" ToolTip="Search folders across tree and chart views (Enter = Next, Shift+Enter = Prev, Esc = Clear, Ctrl+F = Focus)" KeyDown="SearchTextBox_KeyDown" GotFocus="SearchTextBox_GotFocus" Padding="28,6,8,6"/>
                                <Path Data="{StaticResource SearchGeometry}" Style="{StaticResource NavIcon}" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SearchMatchStatusText}" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="2,0,6,0"/>
                                <Button Style="{StaticResource IconButton}" Command="{Binding NavigatePrevMatchCommand}" ToolTip="Previous match (Shift+Enter)" AutomationProperties.Name="Previous match" Width="26" Height="26" Padding="4">
                                    <Path Data="{StaticResource ChevronLeftGeometry}" Style="{StaticResource NavIcon}" Width="9" Height="9"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Command="{Binding NavigateNextMatchCommand}" ToolTip="Next match (Enter)" AutomationProperties.Name="Next match" Width="26" Height="26" Padding="4" Margin="2,0,0,0">
                                    <Path Data="{StaticResource ChevronRightGeometry}" Style="{StaticResource NavIcon}" Width="9" Height="9"/>
                                </Button>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="4,0,0,0" Command="{Binding ClearSearchCommand}" ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear search" Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}}" Width="26" Height="26" Padding="4">
                                <Path Data="{StaticResource CloseGeometry}" Style="{StaticResource NavIcon}" Width="9" Height="9"/>
                            </Button>
                        </Grid>

                        <!-- Search Results Popup -->
                        <Popup x:Name="SearchResultsPopup" PlacementTarget="{Binding ElementName=SearchTextBox}" Placement="Bottom" IsOpen="{Binding IsSearchDropdownOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide" VerticalOffset="4">
                            <Border Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1.5" CornerRadius="6" Width="{Binding ActualWidth, ElementName=SearchTextBox}" MaxHeight="260" Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3" Color="#000000"/>
                                </Border.Effect>
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="6,4,6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Matching Folders" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SearchMatchStatusText}" FontSize="11" Foreground="{DynamicResource BrushAccent}"/>
                                    </Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding MatchingSearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ItemBorder" Margin="0,1" Padding="8,6" Background="Transparent" CornerRadius="4" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectSearchResultCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource FolderGeometry}" Style="{StaticResource FolderIcon}" Width="13" Height="13" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding FullPathDisplay}" Style="{StaticResource SubText}" FontSize="11" Margin="19,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Style="{StaticResource ToolButton}" Padding="6,3" FontSize="11" Command="{Binding DataContext.OpenSearchResultInExplorerCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}" ToolTip="Open this folder in Windows Explorer" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource ExplorerGeometry}" Style="{StaticResource NavIcon}" Width="11" Height="11" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="Explorer" FontSize="11"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>

                        <!-- Chart Sub-Toolbar -->
                        <Border Background="{DynamicResource BrushAccentSoft}" CornerRadius="6" Padding="10,5" Margin="0,8,0,0" Visibility="{Binding IsOrgChartView, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Double-click to open in Explorer · Drag to move · Drag canvas to pan" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleOrgChartLayoutCommand}" ToolTip="Toggle chart layout direction (Horizontal / Vertical)" Margin="0,0,4,0" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource ChartGeometry}" Style="{StaticResource NavIcon}" Width="11" Height="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding OrgChartLayoutButtonText}" FontSize="11.5"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Click="ZoomOutOrgChart_Click" ToolTip="Zoom out (Ctrl + -)" AutomationProperties.Name="Zoom out" Width="26" Height="26" Padding="4">
                                        <Path Data="{StaticResource MinusGeometry}" Style="{StaticResource NavIcon}" Width="10" Height="10"/>
                                    </Button>
                                    <Button x:Name="ZoomPercentageButton" Content="100%" Style="{StaticResource ToolButton}" Click="ResetZoomOrgChart_Click" ToolTip="Reset zoom to 100% (Ctrl + 0)" FontWeight="SemiBold" FontSize="11" Padding="6,3" Margin="2,0"/>
                                    <Button Style="{StaticResource IconButton}" Click="ZoomInOrgChart_Click" ToolTip="Zoom in (Ctrl + +)" AutomationProperties.Name="Zoom in" Width="26" Height="26" Padding="4">
                                        <Path Data="{StaticResource PlusGeometry}" Style="{StaticResource NavIcon}" Width="10" Height="10"/>
                                    </Button>
                                    <Button Content="Fit" Style="{StaticResource ToolButton}" Click="FitOrgChart_Click" ToolTip="Fit entire chart to available space (Ctrl + Shift + F)" FontSize="11.5" Padding="7,3" Margin="3,0,4,0"/>
                                    <Button Style="{StaticResource ToolButton}" Click="ExportOrgChart_Click" ToolTip="Export diagram as PNG, SVG, or PDF file" Margin="0,0,4,0" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource CameraGeometry}" Style="{StaticResource NavIcon}" Width="11" Height="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="Export" FontSize="11.5"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleFullscreenCommand}" ToolTip="Fullscreen meeting mode (F11)" Margin="0,0,4,0" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource ExpandGeometry}" Style="{StaticResource NavIcon}" Width="11" Height="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="Fullscreen" FontSize="11.5"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Secondary Chart Options Overflow Menu -->
                                    <Button Style="{StaticResource IconButton}" Click="PlanOverflowButton_Click" ToolTip="More chart options" AutomationProperties.Name="More chart options" Width="26" Height="26" Padding="4">
                                        <Path Data="{StaticResource MoreGeometry}" Style="{StaticResource NavIconFilled}" Width="12" Height="12"/>
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Fit Width (Fill Viewport)" Click="FitWidthOrgChart_Click">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource FitGeometry}" Style="{StaticResource NavIcon}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Fullscreen Meeting Mode" InputGestureText="F11" Command="{Binding ToggleFullscreenCommand}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource ExpandGeometry}" Style="{StaticResource NavIcon}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Expand All Branches" Command="{Binding ExpandAllOrgChartCommand}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource ExpandGeometry}" Style="{StaticResource NavIcon}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Collapse to Top Level" Command="{Binding CollapseAllOrgChartCommand}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource CollapseGeometry}" Style="{StaticResource NavIcon}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Toggle Destination Sidebar" Command="{Binding ToggleDestinationSidebarCommand}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource DriveGeometry}" Style="{StaticResource NavIcon}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Tree Sub-Toolbar -->
                        <Border Background="{DynamicResource BrushAccentSoft}" CornerRadius="6" Padding="10,5" Margin="0,8,0,0" Visibility="{Binding IsOrgChartView, Converter={StaticResource InverseBoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Drag &amp; drop folders to reorder or re-parent. Right-click for options." FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Destination" Style="{StaticResource ToolButton}" Command="{Binding ToggleDestinationSidebarCommand}" ToolTip="Collapse or restore the destination sidebar" Visibility="{Binding ShouldShowDestinationSidebarToggle, Converter={StaticResource BoolToVis}}" Margin="0,0,4,0" Padding="6,4"/>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleFullscreenCommand}" ToolTip="Fullscreen meeting mode (F11)" Margin="0,0,2,0" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource ExpandGeometry}" Style="{StaticResource NavIcon}" Width="11" Height="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="Fullscreen" FontSize="11.5"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding ExpandAllTreeCommand}" ToolTip="Expand all folder branches in tree" Margin="0,0,2,0" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource ExpandGeometry}" Style="{StaticResource NavIcon}" Width="11" Height="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="Expand all" FontSize="11.5"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding CollapseAllTreeCommand}" ToolTip="Collapse all subfolder branches in tree" Margin="0,0,0,0" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource CollapseGeometry}" Style="{StaticResource NavIcon}" Width="11" Height="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="Collapse all" FontSize="11.5"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Plan Visualization / Content Grid -->
                    <Grid>
                        <!-- Editable TreeView -->
                        <TreeView x:Name="StructureTreeView" ItemsSource="{Binding RootFolders}" SelectedItemChanged="StructureTreeView_SelectedItemChanged" Visibility="{Binding IsOrgChartView, Converter={StaticResource InverseBoolToVis}}" AllowDrop="True" PreviewMouseLeftButtonDown="StructureTreeView_PreviewMouseLeftButtonDown" PreviewMouseMove="StructureTreeView_PreviewMouseMove" DragOver="StructureTreeView_DragOver" Drop="StructureTreeView_Drop">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Setter Property="Tag" Value="{Binding DataContext, ElementName=StructureTreeView}"/>
                                    <EventSetter Event="Selected" Handler="TreeViewItem_Selected"/>
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Open in Explorer" Command="{Binding OpenInExplorerCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource ExplorerGeometry}" Style="{StaticResource NavIcon}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Add Child Folder" Command="{Binding AddChildFolderCommand}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource PlusGeometry}" Style="{StaticResource NavIcon}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Add Sibling Folder" Command="{Binding AddSiblingFolderCommand}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource FolderGeometry}" Style="{StaticResource NavIcon}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Move to Root" Command="{Binding MoveToRootCommand}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource ArrowUpGeometry}" Style="{StaticResource NavIcon}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Rename" Command="{Binding StartRenameCommand}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource EditGeometry}" Style="{StaticResource NavIcon}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Delete" Command="{Binding DeleteNodeCommand}" Foreground="{DynamicResource BrushDanger}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource TrashGeometry}" Style="{StaticResource NavIcon}" Stroke="{DynamicResource BrushDanger}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Grid>
                                        <Border CornerRadius="4" Padding="4,2" Margin="-2,-1" Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMatchingSearch}" Value="True">
                                                            <Setter Property="Background" Value="#FEF08A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource FolderGeometry}" Style="{StaticResource FolderIcon}"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12.5" VerticalAlignment="Center" MouseDown="StructureNodeText_MouseDown">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMatchingSearch}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Setter Property="Foreground" Value="#854D0E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border Background="{DynamicResource BrushAccentSoft}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" Visibility="{Binding HasDiffBadge, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding DiffBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" Padding="3,1" FontSize="12.5" LostFocus="RenameTextBox_LostFocus" KeyDown="RenameTextBox_KeyDown" Loaded="RenameTextBox_Loaded"/>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <!-- Visual Interactive Org Chart -->
                        <views:OrgChartView x:Name="OrgChartHost" LayoutDirection="{Binding IsVerticalOrgChart, Converter={StaticResource BoolToLayoutDirection}}" Visibility="{Binding IsOrgChartView, Converter={StaticResource BoolToVis}}"/>

                        <!-- Restrained Clean Empty State Prompt -->
                        <Border Background="{DynamicResource BrushPanel}" Visibility="{Binding HasStructureNodes, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340">
                                <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource BrushAccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Path Data="{StaticResource FolderGeometry}" Fill="{DynamicResource BrushAccent}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Start a folder plan" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Add a root folder to build your hierarchy, or import an existing directory as a starting point." Style="{StaticResource SubText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,16"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddRootFolderCommand}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource PlusGeometry}" Style="{StaticResource NavIcon}" Stroke="{DynamicResource BrushPrimaryBtnFg}" Width="11" Height="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="Add root folder" FontSize="12.5"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding ImportFromReferenceCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource ImportGeometry}" Style="{StaticResource NavIcon}" Width="11" Height="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="Import folder" FontSize="12.5"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Fullscreen Meeting Floating HUD Overlay -->
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,16,16,0"
                                Background="{DynamicResource BrushPanel}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="6,3"
                                Visibility="{Binding IsFullscreenMode, Converter={StaticResource BoolToVis}}"
                                Panel.ZIndex="100">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- In Org Chart: show layout & zoom controls -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsOrgChartView, Converter={StaticResource BoolToVis}}">
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleOrgChartLayoutCommand}" ToolTip="Toggle chart layout (Horizontal / Vertical)" Padding="6,3" Margin="0,0,3,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource ChartGeometry}" Style="{StaticResource NavIcon}" Width="11" Height="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding OrgChartLayoutButtonText}" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Click="ZoomOutOrgChart_Click" ToolTip="Zoom out (Ctrl + -)" Width="24" Height="24" Padding="3">
                                        <Path Data="{StaticResource MinusGeometry}" Style="{StaticResource NavIcon}" Width="9" Height="9"/>
                                    </Button>
                                    <Button x:Name="FullscreenZoomPercentageButton" Content="100%" Style="{StaticResource ToolButton}" Click="ResetZoomOrgChart_Click" ToolTip="Reset zoom to 100% (Ctrl + 0)" FontWeight="SemiBold" FontSize="10.5" Padding="5,2" Margin="2,0"/>
                                    <Button Style="{StaticResource IconButton}" Click="ZoomInOrgChart_Click" ToolTip="Zoom in (Ctrl + +)" Width="24" Height="24" Padding="3">
                                        <Path Data="{StaticResource PlusGeometry}" Style="{StaticResource NavIcon}" Width="9" Height="9"/>
                                    </Button>
                                    <Button Content="Fit" Style="{StaticResource ToolButton}" Click="FitOrgChart_Click" ToolTip="Fit to view (Ctrl + Shift + F)" FontSize="11" Padding="6,2" Margin="2,0,6,0"/>
                                    <Rectangle Width="1" Height="16" Fill="{DynamicResource BrushBorder}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Exit Fullscreen Button -->
                                <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleFullscreenCommand}" ToolTip="Exit fullscreen meeting mode (F11 or Esc)" Background="{DynamicResource BrushAccentSoft}" BorderBrush="{DynamicResource BrushAccent}" Foreground="{DynamicResource BrushAccent}" Padding="8,3">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource CollapseGeometry}" Style="{StaticResource NavIcon}" Stroke="{DynamicResource BrushAccent}" Width="11" Height="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="Exit Fullscreen (F11)" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Destination, status, and final action clearly grouped together -->
        <Border Grid.Row="2" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0" Visibility="{Binding IsFullscreenMode, Converter={StaticResource InverseBoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,4">
                        <Path Data="{StaticResource DriveGeometry}" Style="{StaticResource NavIcon}" Width="12" Height="12" Margin="0,0,6,0" Stroke="{DynamicResource BrushAccent}"/>
                        <TextBlock Text="DESTINATION PATH" Style="{StaticResource SubText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding CompareBlueprintWithDiskCommand}" ToolTip="Compare folder plan against destination disk" Padding="6,2" FontSize="11.5" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource DiffGeometry}" Style="{StaticResource NavIcon}" Width="11" Height="11" Margin="0,0,4,0"/>
                                <TextBlock Text="Diff vs Disk" FontSize="11.5"/>
                            </StackPanel>
                        </Button>
                        <Border Background="{DynamicResource BrushAccentSoft}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Visibility="{Binding IsDiffActive, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DiffSummaryText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}"/>
                                <Button Style="{StaticResource IconButton}" Command="{Binding ClearDiffCommand}" ToolTip="Clear diff view" Width="18" Height="18" Padding="2" Margin="6,0,0,0">
                                    <Path Data="{StaticResource CloseGeometry}" Style="{StaticResource NavIcon}" Width="8" Height="8"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConciseStatusText}" ToolTip="{Binding DetailedStatusTooltip}" Style="{StaticResource SubText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,4" HorizontalAlignment="Right" Cursor="Help"/>
                    <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Tag="Select a folder on left or enter destination path..." FontFamily="Consolas" ToolTip="Select a folder on left or type destination path" Padding="8,6"/>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Command="{Binding CreateMissingFoldersOnlyCommand}" ToolTip="Create only missing folders on disk without touching existing folders" Padding="14,9" Margin="0,0,8,0" Visibility="{Binding HasMissingFolders, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource CheckGeometry}" Style="{StaticResource NavIcon}" Stroke="{DynamicResource BrushAccent}" Width="12" Height="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Create Missing Only" FontSize="12.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CreateStructureCommand}" ToolTip="{Binding CreateButtonTooltip}" Padding="22,9" MinWidth="160">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource CheckGeometry}" Style="{StaticResource NavIcon}" Stroke="{DynamicResource BrushPrimaryBtnFg}" Width="13" Height="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Create folders" FontSize="13.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Spotlight Command Palette (Ctrl + K) Overlay -->
        <Border x:Name="CommandPaletteOverlay"
                Grid.RowSpan="3"
                Background="#90000000"
                Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="5000"
                MouseDown="CommandPaletteOverlay_MouseDown">
            <Border Width="560"
                    MaxHeight="440"
                    VerticalAlignment="Top"
                    Margin="0,80,0,0"
                    Background="{DynamicResource BrushPanel}"
                    BorderBrush="{DynamicResource BrushAccent}"
                    BorderThickness="1.5"
                    CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <DockPanel Margin="14">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource SearchGeometry}" Style="{StaticResource NavIcon}" Stroke="{DynamicResource BrushAccent}" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="CommandPaletteSearchInput"
                                 Grid.Column="1"
                                 Text="{Binding CommandPaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Type a command or feature... (e.g. Dark, Export, Tree, Diff)"
                                 FontSize="13"
                                 Padding="10,8"
                                 KeyDown="CommandPaletteSearchInput_KeyDown"
                                 Loaded="CommandPaletteSearchInput_Loaded"/>
                        <Border Grid.Column="2" Background="{DynamicResource BrushAccentSoft}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ESC" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}"/>
                        </Border>
                    </Grid>

                    <ListBox x:Name="CommandPaletteListBox"
                             ItemsSource="{Binding FilteredCommands}"
                             SelectedItem="{Binding SelectedCommandPaletteItem, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             FocusVisualStyle="{x:Null}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="10,7"
                                                    Margin="2,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.ExecuteCommandPaletteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="4" Background="{DynamicResource BrushAccentSoft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="{Binding Category}" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource BrushBg}"
                                                BorderBrush="{DynamicResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShortcutHint}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ShortcutHint}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>
