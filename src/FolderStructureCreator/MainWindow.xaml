<Window x:Class="FolderStructureCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FolderStructureCreator.ViewModels"
        xmlns:conv="clr-namespace:FolderStructureCreator.Converters"
        xmlns:views="clr-namespace:FolderStructureCreator.Views"
        Title="Folder Structure Creator" Height="720" Width="1180" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" Icon="AppIcon.ico"
        Background="{StaticResource BrushBg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:BoolToGridLengthConverter x:Key="BoolToGridLength"/>
        <conv:PlaceholderBrushConverter x:Key="PlaceholderBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Window.DataContext><vm:MainViewModel/></Window.DataContext>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Folder Structure Creator" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                <TextBlock Text="Design a reusable folder plan, then create it in a target destination." Style="{StaticResource SubText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource StepBadgeActive}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="1. Build Blueprint" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="➔" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="2,0,8,0" FontSize="12"/>
                <Border Style="{StaticResource StepBadge}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="2. Select Destination" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="➔" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="2,0,8,0" FontSize="12"/>
                <Border Style="{StaticResource StepBadge}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="3. Create Folders" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding IsDestinationSidebarCollapsed, Converter={StaticResource BoolToGridLength}, ConverterParameter=0.9}" MinWidth="0"/><ColumnDefinition Width="{Binding IsDestinationSidebarCollapsed, Converter={StaticResource BoolToGridLength}, ConverterParameter=Auto}"/><ColumnDefinition Width="1.35*" MinWidth="390"/></Grid.ColumnDefinitions>
            <!-- The destination browser stays visible in both plan views. -->
            <Border Grid.Column="0" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Visibility="{Binding IsDestinationSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                <DockPanel Margin="12">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💻 Real Computer Drives" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <TextBlock Text="Select target destination folder on your disk" Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="📌 Pin" Style="{StaticResource ToolButton}" Command="{Binding PinSelectedFolderCommand}" ToolTip="Pin selected folder for easy chart view access"/>
                            <Button Content="Use as plan" Style="{StaticResource ToolButton}" Command="{Binding ShowSelectedFolderOrgChartCommand}" ToolTip="Copy the selected folder's hierarchy into the plan"/>
                            <Button Content="Refresh" Style="{StaticResource ToolButton}" Command="{Binding RefreshDrivesCommand}" ToolTip="Refresh available drives"/>
                        </StackPanel>
                    </Grid>

                    <!-- Pinned Folders Section -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,10" Background="{StaticResource BrushAccentSoft}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6" Visibility="{Binding HasPinnedFolders, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="📌 Pinned Folders" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Grid.Column="1" Text="Quick Target Access" Style="{StaticResource SubText}" FontSize="10"/>
                            </Grid>
                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PinnedFolders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,2" Padding="6,4" Background="{StaticResource BrushPanel}" CornerRadius="4" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" ToolTip="{Binding Path}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📂 " FontSize="12" Foreground="#F59E0B"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="11.5" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="110" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Content="📊 Chart" Style="{StaticResource ToolButton}" Padding="5,2" FontSize="10.5" Command="{Binding DataContext.ShowPinnedFolderChartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Open chart view for this pinned folder"/>
                                                        <Button Content="🎯" Style="{StaticResource ToolButton}" Padding="4,2" FontSize="10.5" Margin="2,0,0,0" Command="{Binding DataContext.SelectPinnedFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Select as target destination"/>
                                                        <Button Content="✕" Style="{StaticResource ToolButton}" Padding="4,2" FontSize="10.5" Margin="2,0,0,0" Command="{Binding DataContext.UnpinFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Unpin folder"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <TreeView x:Name="DirectoryTreeView" ItemsSource="{Binding Drives}" SelectedItemChanged="DirectoryTreeView_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="📊 View Chart" Command="{Binding ShowSelectedFolderOrgChartCommand}"/>
                                            <MenuItem Header="📌 Pin folder" Command="{Binding PinSelectedFolderCommand}"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📂 " FontSize="11" Foreground="#F59E0B"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{Binding IsPlaceholder, Converter={StaticResource PlaceholderBrush}}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Visibility="{Binding IsDestinationSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>

            <Border Grid.Column="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="📝 Folder Blueprint (Draft)" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource SubText}"><Run Text="{Binding TotalFolderCount, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" folders in this plan"/></TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <CheckBox Content="Live computer sync" IsChecked="{Binding IsLiveSyncMode}" ToolTip="When checked, adding, renaming, deleting (Recycle Bin), and drag &amp; drop moving directly updates physical folders on disk." VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="Tree" Command="{Binding ShowTreeViewCommand}" ToolTip="Editable indented list view"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ToolButton}"><Style.Triggers><DataTrigger Binding="{Binding IsOrgChartView}" Value="False"><Setter Property="Background" Value="{StaticResource BrushAccent}"/><Setter Property="Foreground" Value="#0F172A"/><Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="Chart" Command="{Binding ShowOrgChartViewCommand}" ToolTip="Visual folder diagram"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ToolButton}"><Style.Triggers><DataTrigger Binding="{Binding IsOrgChartView}" Value="True"><Setter Property="Background" Value="{StaticResource BrushAccent}"/><Setter Property="Foreground" Value="#0F172A"/><Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="+ Add root" Style="{StaticResource ToolButton}" Command="{Binding AddRootFolderCommand}" Background="{StaticResource BrushAccentSoft}" BorderBrush="{StaticResource BrushAccent}" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold"/>
                            <Button Content="📥 Import folder" Style="{StaticResource ToolButton}" Command="{Binding ImportFromReferenceCommand}"/>
                            <Button Content="Clear" Style="{StaticResource ToolButton}" Command="{Binding ClearPlanCommand}"/>
                            <Separator Width="1" Height="22" Background="{StaticResource BrushBorder}" Margin="5,0,10,0" Visibility="{Binding HasSelectedStructureNode, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="➕ Add child" Style="{StaticResource ToolButton}" Command="{Binding AddChildFolderCommand}" Visibility="{Binding HasSelectedStructureNode, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="➕ Add sibling" Style="{StaticResource ToolButton}" Command="{Binding AddSiblingFolderCommand}" Visibility="{Binding HasSelectedStructureNode, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="✏️ Rename" Style="{StaticResource ToolButton}" Command="{Binding StartRenameCommand}" Visibility="{Binding HasSelectedStructureNode, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="🗑️ Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteNodeCommand}" Visibility="{Binding HasSelectedStructureNode, Converter={StaticResource BoolToVis}}"/>
                        </WrapPanel>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding QuickAddNames, UpdateSourceTrigger=PropertyChanged}" Tag="Add names: src, docs, tests" ToolTip="Comma-separated names; added under the selected folder"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding QuickAddCommand}"/></TextBox.InputBindings></TextBox><Button Grid.Column="1" Content="Add" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Command="{Binding QuickAddCommand}" Visibility="{Binding HasQuickAddText, Converter={StaticResource BoolToVis}}"/></Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchTextBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Tag="🔍 Search folders in plan..." ToolTip="Search folders across tree and chart views (Enter = Next, Shift+Enter = Prev, Esc = Clear, Ctrl+F = Focus)" KeyDown="SearchTextBox_KeyDown" GotFocus="SearchTextBox_GotFocus"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SearchMatchStatusText}" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="2,0,6,0"/>
                                <Button Content="‹" Style="{StaticResource ToolButton}" Command="{Binding NavigatePrevMatchCommand}" ToolTip="Previous match (Shift+Enter)" Padding="6,1"/>
                                <Button Content="›" Style="{StaticResource ToolButton}" Command="{Binding NavigateNextMatchCommand}" ToolTip="Next match (Enter)" Padding="6,1" Margin="2,0,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="✕" Style="{StaticResource ToolButton}" Margin="4,0,0,0" Command="{Binding ClearSearchCommand}" ToolTip="Clear search (Esc)" Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <Popup x:Name="SearchResultsPopup" PlacementTarget="{Binding ElementName=SearchTextBox}" Placement="Bottom" IsOpen="{Binding IsSearchDropdownOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide" VerticalOffset="4">
                            <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1.5" CornerRadius="6" Width="{Binding ActualWidth, ElementName=SearchTextBox}" MaxHeight="260" Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3" Color="#000000"/>
                                </Border.Effect>
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="6,4,6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Matching Folders" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SearchMatchStatusText}" FontSize="10.5" Foreground="{StaticResource BrushAccent}"/>
                                    </Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding MatchingSearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ItemBorder" Margin="0,1" Padding="8,6" Background="Transparent" CornerRadius="4" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectSearchResultCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="📂 " FontSize="12" Foreground="#F59E0B"/>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding FullPathDisplay}" Style="{StaticResource SubText}" FontSize="10.5" Margin="16,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="📂 Explorer" Style="{StaticResource ToolButton}" Padding="6,3" FontSize="11" Command="{Binding DataContext.OpenSearchResultInExplorerCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}" ToolTip="Open this folder location in Windows Explorer" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushAccentSoft}"/>
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                        <Border Background="{StaticResource BrushAccentSoft}" CornerRadius="5" Padding="8,5" Margin="0,8,0,0" Visibility="{Binding IsOrgChartView, Converter={StaticResource BoolToVis}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Double-click to rename. Drag &amp; drop a box onto another to move it." Style="{StaticResource SubText}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Toggle destination" Style="{StaticResource ToolButton}" Command="{Binding ToggleDestinationSidebarCommand}" ToolTip="Collapse or restore the destination sidebar" Visibility="{Binding ShouldShowDestinationSidebarToggle, Converter={StaticResource BoolToVis}}"/><Button Content="−" Style="{StaticResource ToolButton}" Click="ZoomOutOrgChart_Click" ToolTip="Zoom out"/><Button Content="Fit" Style="{StaticResource ToolButton}" Click="FitOrgChart_Click" ToolTip="Fit chart to available space"/><Button Content="+" Style="{StaticResource ToolButton}" Click="ZoomInOrgChart_Click" ToolTip="Zoom in"/></StackPanel></Grid></Border>
                    </StackPanel>

                    <Grid>
                        <TreeView x:Name="StructureTreeView" ItemsSource="{Binding RootFolders}" SelectedItemChanged="StructureTreeView_SelectedItemChanged" Visibility="{Binding IsOrgChartView, Converter={StaticResource InverseBoolToVis}}">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                    <EventSetter Event="Selected" Handler="TreeViewItem_Selected"/>
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Open in Explorer" Command="{Binding OpenInExplorerCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="Add child" Command="{Binding AddChildFolderCommand}"/>
                                                <MenuItem Header="Add sibling" Command="{Binding AddSiblingFolderCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="Rename" Command="{Binding StartRenameCommand}"/>
                                                <MenuItem Header="Delete" Command="{Binding DeleteNodeCommand}" Foreground="{StaticResource BrushDanger}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Grid>
                                        <Border CornerRadius="3" Padding="3,1" Margin="-3,-1" Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMatchingSearch}" Value="True">
                                                            <Setter Property="Background" Value="#FEF08A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📂 " FontSize="11" Foreground="#F59E0B"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" MouseDown="StructureNodeText_MouseDown">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMatchingSearch}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Setter Property="Foreground" Value="#854D0E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" Padding="2,1" LostFocus="RenameTextBox_LostFocus" KeyDown="RenameTextBox_KeyDown" Loaded="RenameTextBox_Loaded"/>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <views:OrgChartView x:Name="OrgChartHost" Visibility="{Binding IsOrgChartView, Converter={StaticResource BoolToVis}}"/>
                        <Border Background="{StaticResource BrushPanel}" Visibility="{Binding HasStructureNodes, Converter={StaticResource InverseBoolToVis}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"><TextBlock Text="Start a folder plan" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/><TextBlock Text="Add a root folder to build it by hand, or import an existing folder as a starting point." Style="{StaticResource SubText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Add root" Style="{StaticResource PrimaryButton}" Command="{Binding AddRootFolderCommand}"/><Button Content="Import folder" Style="{StaticResource ToolButton}" Command="{Binding ImportFromReferenceCommand}"/></StackPanel></StackPanel></Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Destination, status, and final action remain together throughout the workflow. -->
        <Border Grid.Row="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="🎯 DESTINATION PATH" Style="{StaticResource SubText}" FontWeight="SemiBold" Margin="2,0,0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource SubText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,0,4"/>
                    <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Tag="Select a folder on left or enter destination path..." FontFamily="Consolas" ToolTip="Select a folder above or enter a valid path"/>
                </Grid>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding CreateStructureCommand}" ToolTip="Create every folder in the plan under this destination" VerticalAlignment="Center" Padding="22,11" MinWidth="180">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🚀 " FontSize="13.5"/>
                        <TextBlock Text="Create structure" FontSize="13.5" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
