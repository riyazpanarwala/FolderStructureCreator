<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- High Contrast Theme Palette (Accessibility compliant) -->
    <SolidColorBrush x:Key="BrushBg" Color="#000000"/>
    <SolidColorBrush x:Key="BrushPanel" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#FFFF00"/>
    <SolidColorBrush x:Key="BrushAccent" Color="#FFFF00"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="#00FFFF"/>
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#1A1A00"/>
    <SolidColorBrush x:Key="BrushDanger" Color="#FF3333"/>
    <SolidColorBrush x:Key="BrushDangerSoft" Color="#330000"/>
    <SolidColorBrush x:Key="BrushSelected" Color="#005577"/>
    <SolidColorBrush x:Key="BrushHover" Color="#222222"/>
    <SolidColorBrush x:Key="BrushInputBg" Color="#000000"/>
    <SolidColorBrush x:Key="BrushOrgConnector" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushCardBg" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="BrushDropdownBg" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="BrushPrimaryBtnFg" Color="#000000"/>

</ResourceDictionary>
